# Copy this file to .env and fill in your free API key(s) — never commit the real .env

# REQUIRED — this is the only key the core RAG system needs.
# Groq free tier: no credit card, no cost, generous limits (confirmed current as of
# this project). Sign up: https://console.groq.com/keys
GROQ_API_KEY=

# OPTIONAL — only needed for the image-analysis (VLM) tab. Leave blank and the app
# still works fully for text Q&A; the VLM tab will just say it's not configured.
# Google AI Studio (Gemini) free tier: https://aistudio.google.com/apikey
# Note: since March 2026, some regions may be prompted to set up prepaid billing
# for new AI Studio accounts. If that happens to you, skip this — it's not worth
# clearing a billing prompt for an optional module. A no-card alternative (e.g. a
# free Hugging Face vision endpoint) can be swapped into src/vlm/vlm_client.py later.
GOOGLE_API_KEY=

# Which LLM provider to use for text generation: "groq" or "gemini"
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-1.5-flash
